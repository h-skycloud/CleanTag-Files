<UserControl x:Class="Files.App.UserControls.CleanTag.CleanTagReviewView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:helpers="using:Files.App.Helpers" Unloaded="View_Unloaded">
	<Grid Padding="16" RowSpacing="12" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
		<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
		<CommandBar DefaultLabelPosition="Right">
			<CommandBar.Content><TextBlock Text="{helpers:ResourceString Name=CleanTagReview}" Style="{ThemeResource SubtitleTextBlockStyle}" VerticalAlignment="Center"/></CommandBar.Content>
			<AppBarButton Icon="Back" Label="{helpers:ResourceString Name=CleanTagHome}" Click="Back_Click"/>
			<AppBarButton x:Name="ChooseButton" Icon="OpenFile" Label="{helpers:ResourceString Name=CleanTagReviewChooseFolder}" Click="Choose_Click"/>
			<AppBarButton x:Name="RefreshButton" Icon="Refresh" Label="{helpers:ResourceString Name=CleanTagReviewStart}" Click="Start_Click"/>
			<AppBarButton x:Name="DeferredButton" Icon="Clock" Label="{helpers:ResourceString Name=CleanTagReviewDeferred}" Click="Deferred_Click"/>
		</CommandBar>
		<TextBox x:Name="RootPath" Grid.Row="1" PlaceholderText="{helpers:ResourceString Name=CleanTagReviewChooseFolder}" AutomationProperties.Name="{helpers:ResourceString Name=CleanTagReviewChooseFolder}"/>
		<RadioButtons x:Name="Mode" Grid.Row="2" Header="{helpers:ResourceString Name=CleanTagReviewMode}" MaxColumns="2" SelectionChanged="Mode_SelectionChanged">
			<RadioButton Content="{helpers:ResourceString Name=CleanTagReviewFiles}"/>
			<RadioButton Content="{helpers:ResourceString Name=CleanTagReviewFolders}"/>
		</RadioButtons>
		<InfoBar x:Name="Status" Grid.Row="3" IsOpen="True" IsClosable="False" Severity="Informational" Message="{helpers:ResourceString Name=CleanTagReviewIntro}"/>
		<Grid Grid.Row="4" RowSpacing="8">
			<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
			<TextBlock x:Name="ItemTitle" Style="{ThemeResource TitleTextBlockStyle}" TextTrimming="CharacterEllipsis"/>
			<TextBlock x:Name="ItemDetails" Grid.Row="1" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
			<ContentControl x:Name="Preview" Grid.Row="2" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
		</Grid>
		<CommandBar x:Name="Decisions" Grid.Row="5" IsEnabled="False" DefaultLabelPosition="Right">
			<CommandBar.PrimaryCommands>
				<AppBarButton Icon="Delete" Label="{helpers:ResourceString Name=CleanTagReviewDelete}" Click="Delete_Click"/>
				<AppBarButton Icon="Accept" Label="{helpers:ResourceString Name=CleanTagReviewKeep}" Click="Keep_Click"/>
				<AppBarButton Icon="Clock" Label="{helpers:ResourceString Name=CleanTagReviewLater}" Click="Later_Click"/>
				<AppBarSeparator/>
				<AppBarButton Icon="Tag" Label="{helpers:ResourceString Name=CleanTagTags}" Click="Tags_Click"/>
				<AppBarButton Icon="Folder" Label="{helpers:ResourceString Name=CleanTagBrowse}" Click="Browse_Click"/>
			</CommandBar.PrimaryCommands>
		</CommandBar>
	</Grid>
</UserControl>
