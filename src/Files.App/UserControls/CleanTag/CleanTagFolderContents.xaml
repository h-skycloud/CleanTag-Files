<UserControl x:Class="Files.App.UserControls.CleanTag.CleanTagFolderContents"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:Files.App.UserControls.CleanTag"
	xmlns:helpers="using:Files.App.Helpers">
	<Grid RowSpacing="8">
		<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
		<CommandBar DefaultLabelPosition="Right">
			<CommandBar.Content>
				<StackPanel Spacing="2" VerticalAlignment="Center">
					<TextBlock Text="{helpers:ResourceString Name=CleanTagFolderContents}" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
					<TextBlock x:Name="Summary" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
				</StackPanel>
			</CommandBar.Content>
			<AppBarToggleButton x:Name="GridButton" Icon="ViewAll" Label="{helpers:ResourceString Name=CleanTagFolderGrid}" Click="Grid_Click"/>
			<AppBarToggleButton x:Name="ListButton" Icon="List" Label="{helpers:ResourceString Name=CleanTagFolderList}" Click="List_Click"/>
		</CommandBar>
		<GridView x:Name="Tiles" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="False" ItemsSource="{x:Bind Items}" AutomationProperties.Name="{helpers:ResourceString Name=CleanTagFolderContents}">
			<GridView.ItemTemplate>
				<DataTemplate x:DataType="local:CleanTagFolderEntry">
					<Grid Width="144" Padding="8" RowSpacing="4" ToolTipService.ToolTip="{x:Bind Tooltip}" AutomationProperties.Name="{x:Bind Tooltip}">
						<Grid.RowDefinitions><RowDefinition Height="88"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
						<Grid>
							<FontIcon Glyph="{x:Bind Glyph}" Visibility="{x:Bind GlyphVisibility, Mode=OneWay}" FontSize="48" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
							<Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="Uniform"/>
						</Grid>
						<TextBlock Grid.Row="1" Text="{x:Bind Name}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" TextAlignment="Center"/>
						<TextBlock Grid.Row="2" Text="{x:Bind Details}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" TextAlignment="Center"/>
					</Grid>
				</DataTemplate>
			</GridView.ItemTemplate>
		</GridView>
		<ListView x:Name="Rows" Grid.Row="1" Visibility="Collapsed" SelectionMode="None" ItemsSource="{x:Bind Items}" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{helpers:ResourceString Name=CleanTagFolderContents}">
			<ListView.ItemTemplate>
				<DataTemplate x:DataType="local:CleanTagFolderEntry">
					<Grid Padding="4,6" ColumnSpacing="12" ToolTipService.ToolTip="{x:Bind Tooltip}" AutomationProperties.Name="{x:Bind Tooltip}">
						<Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
						<Grid Width="40" Height="40"><FontIcon Glyph="{x:Bind Glyph}" Visibility="{x:Bind GlyphVisibility, Mode=OneWay}" FontSize="28" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="Uniform"/></Grid>
						<StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
							<TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"/>
							<TextBlock Text="{x:Bind Modified}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
						</StackPanel>
						<TextBlock Grid.Column="2" Text="{x:Bind Details}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
					</Grid>
				</DataTemplate>
			</ListView.ItemTemplate>
		</ListView>
		<TextBlock x:Name="Empty" Grid.Row="1" Text="{helpers:ResourceString Name=CleanTagReviewEmptyFolder}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed"/>
		<TextBlock x:Name="Scope" Grid.Row="2" Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
	</Grid>
</UserControl>
