<UserControl x:Class="Files.App.UserControls.CleanTag.StorageTreemap" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:helpers="using:Files.App.Helpers" xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml" Loaded="Control_Loaded" Unloaded="Control_Unloaded">
	<Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
		<canvas:CanvasControl x:Name="Surface" AutomationProperties.Name="{helpers:ResourceString Name=CleanTagMap}" Draw="Surface_Draw" SizeChanged="Surface_SizeChanged" PointerMoved="Surface_PointerMoved" PointerExited="Surface_PointerExited" Tapped="Surface_Tapped" DoubleTapped="Surface_DoubleTapped"/>
		<TextBlock x:Name="EmptyLabel" Text="{helpers:ResourceString Name=CleanTagChooseFolder}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="24" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsHitTestVisible="False"/>
	</Grid>
</UserControl>
